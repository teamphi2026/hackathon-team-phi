# Email (Gmail SMTP with app password, or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SENDGRID_API_KEY=

# Base URL used to build Approve/Reject token links in emails
APP_BASE_URL=http://localhost:8000

# IBM ICA / watsonx model config (orchestrator LLM)
ICA_API_KEY=
ICA_BASE_URL=
ICA_MODEL=gpt-4o

# Demo session identity (set server-side; never from the LLM)
DEMO_USER_ID=E005

# Leave forecast Google Sheet (updated after a manager approves leave).
# Leave GOOGLE_SHEET_ID empty to turn the feature off.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
# Either paste the service-account key JSON on ONE line, or point to the downloaded file:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Local dev only: write to a CSV with the sheet's layout instead of Google
LEAVE_FORECAST_CSV=
