# Email (Gmail SMTP with app password, or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SENDGRID_API_KEY=

# Base URL used to build Approve/Reject token links in emails
APP_BASE_URL=http://localhost:8000

# IBM ICA / watsonx model config (orchestrator LLM)
ICA_API_KEY=
ICA_BASE_URL=
ICA_MODEL=gpt-4o

# Demo session identity (set server-side; never from the LLM)
DEMO_USER_ID=E005

# Persistence: keep csv locally; set google_sheets on Render after the setup check.
DATA_BACKEND=csv
GOOGLE_SHEETS_SPREADSHEET_ID=1ItLM27vcTfpyeuZBQeuhFTvz86ERTqpSG4zpOOapysk
# Render Secret File path; never commit or put these credentials in frontend config.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-service-account.json
# Alternative to a Secret File: GOOGLE_SERVICE_ACCOUNT_JSON (full private JSON).
# Optional filename -> worksheet title mapping, when auto-detection is ambiguous.
GOOGLE_SHEETS_TAB_MAP={}

# Leave forecast Google Sheet (updated after a manager approves leave).
# Leave GOOGLE_SHEET_ID empty to turn the feature off.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
# Shared credentials: GOOGLE_APPLICATION_CREDENTIALS above, or either alternative below:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Local dev only: write to a CSV with the sheet's layout instead of Google
LEAVE_FORECAST_CSV=
